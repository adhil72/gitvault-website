---
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'

const releases = [{
  version: 'v0.1.1', date: 'November 11, 2026', title: 'Updates, checksums and a TypeScript library',
  groups: [
    ['Updates', ['The Windows app checks for signed updates and installs them from Settings, with a quiet notice at startup', 'Every release ships SHA256SUMS next to the installers']],
    ['Developers', ['The Node.js library is now written in TypeScript, with types and both import and require support', 'Published on GitHub Packages as @adhil72/gitvault']],
  ],
}, {
  version: 'v0.1.0', date: 'November 10, 2026', title: 'First public release',
  groups: [
    ['Vaults and secrets', ['Create, connect, unlock and lock encrypted vaults stored in a private GitHub repository', 'Add, edit, rotate and delete secrets with environments, tags, favorites and expiry reminders', 'Master password with Argon2id key derivation, AES-256-GCM encryption and a one-time recovery key']],
    ['History and sync', ['Every change is a git commit, with version history and restore for any secret', 'Sync with GitHub and resolve conflicts side by side when two devices edit the same secret', 'Audit log of reveals and changes']],
    ['Desktop and CLI', ['Desktop app for Windows and Ubuntu, with a password, passphrase and PIN generator', 'gitvault CLI: run and inject secrets without printing them, import and export .env files, JSON output and shell completions', 'Node.js package: import @adhil72/gitvault/config to load secrets into process.env', 'MCP server (gitvault mcp) so AI tools can use secrets without seeing values']],
  ],
}]
---
<Base title="Changelog" current="Changelog">
  <section class="page-head wrap">
    <h1 class="h1">Changelog</h1>
    <p class="lead">New releases, fixes and everything that changed. Every release is listed here.</p>
  </section>
  <section class="wrap" style="padding-bottom:clamp(72px,10vw,128px)">
    {releases.map((r) => (
      <article class="release">
        <div><div class="ver">{r.version}</div><div class="date">{r.date}</div></div>
        <div>
          <h2 class="h2 sm">{r.title}</h2>
          {r.groups.map(([g, items]) => (
            <div class="grp"><span class="label">{g}</span>
              <ul class="ticks">{(items as string[]).map((i) => <li><Icon name="check" size={16} sw={2.25} />{i}</li>)}</ul></div>
          ))}
        </div>
      </article>
    ))}
    <p class="muted" style="box-shadow:0 -1px 0 var(--line-soft);padding-top:40px">Older releases will appear here. Subscribe to the repository on GitHub to get new versions in your inbox.</p>
  </section>
</Base>
