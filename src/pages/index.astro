---
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import { site, href } from '../config'

const vaultRows = ['DATABASE_URL', 'STRIPE_SECRET_KEY', 'OPENAI_API_KEY', 'JWT_SECRET']

const stored = [
  'Encrypted on your device before anything is uploaded',
  'Kept in a private GitHub repo that you own',
  'Synced to every laptop, server and teammate you allow',
  'Every change is saved, so you can restore an old value',
]

const loaders = [
  { label: 'Node.js', title: 'One import', body: 'Add one line at the top of your app. Your secrets are in process.env before anything else runs.',
    code: `<span class="c">// first line of your app</span>
<span class="g">import '@adhil72/gitvault/config'</span>

process.env.DATABASE_URL <span class="c">// ready</span>` },
  { label: 'Any language', title: 'One command', body: 'Start any program through Gitvault and it receives your secrets as environment variables.',
    code: `<span class="g">$</span> gitvault run -- python app.py
<span class="g">$</span> gitvault run -- go run .
<span class="g">$</span> gitvault run -- docker compose up` },
  { label: 'Servers and CI', title: 'One key per machine', body: 'Give each server its own key instead of your password. Revoke it whenever you want.',
    code: `<span class="m">GITVAULT_TOKEN=••••••••
GITVAULT_DEVICE_KEY=••••••••</span>

<span class="g">$</span> gitvault run -- node server.js` },
]

const steps = [
  ['01', 'Sign in with GitHub', 'No new account. Gitvault creates a private repo for your vault and you pick a master password.'],
  ['02', 'Add your secrets', 'Type them into the desktop app, or import the .env file you already have.'],
  ['03', 'Load them in your project', 'Trust the project folder once, add the import, and delete the .env file.'],
]

const claims = [
  ['Only you can read them', 'Secrets are encrypted with your master password on your device. GitHub only stores scrambled data.'],
  ['Never printed, never logged', 'Values go straight into your app. They do not show up in your terminal, your logs or your repo.'],
  ['Free and open source', 'No server to run and no subscription. The code and the vault format are public and MIT licensed.'],
]
---
<Base title={site.name} current="">
  <section class="hero">
    <div class="wrap">
      <h1 class="display">Store your secrets in the cloud.<br /><span class="green">Load them with one line.</span></h1>
      <p class="lead">Gitvault keeps your API keys and passwords encrypted in a private GitHub repo you own, and loads them into your app when it starts. No more .env files to copy, share or lose.</p>
      <div class="cta-row">
        <a class="btn btn-primary" href={href('/download/')}>Download for Windows</a>
        <a class="btn" href={href('/download/')}>Download for Ubuntu</a>
      </div>
      <p class="meta">v{site.version} &nbsp;·&nbsp; free and open source</p>

      <div class="pipe">
        <div class="panel">
          <div class="panel-bar"><Icon name="cloud" size={16} />Your vault, in the cloud</div>
          <ul class="rows">
            {vaultRows.map((r) => <li><Icon name="lock" size={14} /><span>{r}</span><i>••••••••••••</i></li>)}
          </ul>
          <p class="panel-foot">Encrypted · private GitHub repo</p>
        </div>
        <div class="pipe-arrow" aria-hidden="true"><Icon name="arrow" size={22} /><span>autoload</span></div>
        <div class="panel">
          <div class="panel-bar"><Icon name="code" size={16} />Your code</div>
          <pre class="code" set:html={`<span class="g">import '@adhil72/gitvault/config'</span>

<span class="c">// that's it. your secrets are loaded.</span>
connect(process.env.DATABASE_URL)
stripe(process.env.STRIPE_SECRET_KEY)`} />
          <p class="panel-foot">No .env file · nothing to copy</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="store">
    <div class="wrap split">
      <div class="stack" style="gap:20px">
        <span class="label green">1 · Store</span>
        <h2 class="h2">One safe place for every secret</h2>
        <p class="lead">Add a secret once in the app. It is encrypted and saved to the cloud, ready on every machine you use.</p>
        <ul class="ticks" style="font-size:16px;margin-top:8px">
          {stored.map((s) => <li><Icon name="check" size={16} sw={2.25} />{s}</li>)}
        </ul>
      </div>
      <div class="shot plain"><img src={href('/app-vault.png')} width="1400" height="875" alt="The Gitvault app showing a list of secrets and the details of one secret" /></div>
    </div>
  </section>

  <section class="section" id="autoload">
    <div class="wrap">
      <div class="sec-head">
        <span class="label green">2 · Autoload</span>
        <h2 class="h2">Your code gets its secrets by itself</h2>
        <p class="lead">Pick the way that fits your project. Each one is a single line.</p>
      </div>
      <div class="cols c3">
        {loaders.map((l) => (
          <article class="card">
            <span class="label muted">{l.label}</span>
            <h3 class="h2" style="font-size:1.625rem">{l.title}</h3>
            <p class="muted" style="font-size:15px;line-height:1.6">{l.body}</p>
            <pre class="code grow" set:html={l.code} />
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="how">
    <div class="wrap">
      <div class="sec-head"><h2 class="h2">Set up in about two minutes</h2></div>
      <div class="steps">
        {steps.map(([n, t, b]) => <div class="step"><span class="n">{n}</span><h3 class="h3" style="font-size:1.375rem">{t}</h3><p>{b}</p></div>)}
      </div>
      <pre class="code setup" set:html={`<span class="g">$</span> gitvault import env .env      <span class="c"># bring in what you have</span>
<span class="g">$</span> gitvault trust add .           <span class="c"># this folder may load secrets</span>
<span class="g">$</span> rm .env                        <span class="c"># you don't need it any more</span>`} />
    </div>
  </section>

  <section class="section" id="security">
    <div class="wrap">
      <div class="claims">
        {claims.map(([t, b]) => <div class="claim"><h3 class="h3" style="font-size:1.125rem">{t}</h3><p>{b}</p></div>)}
      </div>
      <p class="center more"><a href={href('/security/')}>How the encryption works <Icon name="arrow" size={16} /></a></p>
    </div>
  </section>

  <section class="section" style="padding-top:40px">
    <div class="wrap">
      <div class="cta-card">
        <h2 class="h1" style="font-size:3rem">Stop copying .env files</h2>
        <p class="lead" style="max-width:600px">Download Gitvault, add your secrets once, and let your projects load them.</p>
        <div class="cta-row"><a class="btn btn-primary" href={href('/download/')}>Download for Windows</a><a class="btn" href={href('/download/')}>Download for Ubuntu</a></div>
        <p class="meta">Windows 10 or later &nbsp;·&nbsp; Ubuntu 22.04 or later &nbsp;·&nbsp; Requires git</p>
      </div>
    </div>
  </section>
</Base>
