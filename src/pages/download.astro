---
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import { site } from '../config'

const downloadUrl = (name: string) => `${site.releasesUrl}/${name}`

const needs = [
  { title: 'Git on your PATH', body: 'GitVault uses git directly for commits, pull --rebase, push, and versioned history inside your hidden vault store.' },
  { title: 'GitHub CLI (gh) signed in', body: 'Run gh auth login once. GitVault requires gh to create, clone, and authenticate with your private gitvault-store repository.' },
  { title: 'A master password', body: 'Never leaves your device. Derives an Argon2id key to protect your vault key, paired with a one-time recovery key.' },
]

const archives = [
  { label: 'Linux x86_64', file: 'gitvault-x86_64-unknown-linux-gnu.tar.gz' },
  { label: 'macOS Apple Silicon', file: 'gitvault-aarch64-apple-darwin.tar.gz' },
  { label: 'Windows x86_64', file: 'gitvault-x86_64-pc-windows-msvc.zip' },
]
---
<Base title="Install" description="Install the GitVault v2 CLI (gitvault and gv). Requires git and GitHub CLI (gh).">
  <section class="wrap page-head">
    <span class="eyebrow">Install · v{site.version}</span>
    <h1 class="t-1">Install GitVault CLI</h1>
    <p class="lead">Free and open source. Installs the <code>gitvault</code> binary and its short alias <code>gv</code>. Requires <code>git</code> and the GitHub CLI (<code>gh</code>).</p>
  </section>

  <section class="wrap">
    <div class="split">
      <div>
        <h2 class="t-2">Quick install script</h2>
        <p class="lead">Checks that <code>git</code> and <code>gh</code> are installed, installs the prebuilt release binary (or builds with Cargo if needed), and links <code>gv</code>.</p>
      </div>
      <pre class="code" set:html={`<span class="p">$</span> gh auth login
<span class="p">$</span> curl -fsSL ${site.installScriptUrl} | sh
<span class="c"># optional: enable in-shell loading</span>
<span class="p">$</span> eval "$(gitvault shell-init)"`} />
    </div>

    <div class="archives">
      {archives.map((a) => (
        <a class="card archive" href={downloadUrl(a.file)}>
          <div>
            <b>{a.label}</b>
            <span class="meta">{a.file}</span>
          </div>
          <Icon name="download" size={18} sw={2} />
        </a>
      ))}
    </div>
    <p class="verify"><Icon name="shield" size={16} />Verify downloads with <code>sha256sum -c SHA256SUMS --ignore-missing</code> · <a class="prose-link" href={downloadUrl('SHA256SUMS')}>SHA256SUMS</a> · <a class="prose-link" href={site.releasesPage}>All releases</a></p>
  </section>

  <section class="band">
    <div class="wrap">
      <h2 class="t-2 sec-title">Prerequisites</h2>
      <ul class="needs">
        {needs.map((n) => <li><h3 class="t-3">{n.title}</h3><p>{n.body}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="band">
    <div class="wrap split">
      <div>
        <h2 class="t-2">Build from source</h2>
        <p class="lead">GitVault v2 is a standalone, single-crate Rust CLI (MIT licensed). Only stable Rust, <code>git</code>, and <code>gh</code> are required.</p>
        <p><a class="arrow-link" href={site.repoUrl}>Source on GitHub <Icon name="arrow" size={16} sw={2} /></a></p>
      </div>
      <pre class="code" set:html={`<span class="p">$</span> cargo install --git ${site.repoUrl} --locked
<span class="c"># or clone and run the local installer:</span>
<span class="p">$</span> git clone ${site.repoUrl}.git
<span class="p">$</span> cd gitvault && ./scripts/install.sh`} />
    </div>
  </section>
</Base>

<style>
  .split { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 56px; align-items: center; }
  .split > div { display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  .archives { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-top: 32px; }
  .archive { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 20px 22px; transition: border-color 0.15s; }
  .archive:hover { border-color: var(--accent); }
  .archive div { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .archive .meta { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .archive svg { flex: none; color: var(--ink-2); }
  .verify { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 24px 0 clamp(72px, 10vw, 120px); font-size: 0.875rem; color: var(--ink-2); }
  .verify svg { color: var(--ink-2); }
  .sec-title { margin-bottom: 40px; }
  .needs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px; }
  .needs li { display: flex; flex-direction: column; gap: 10px; padding-top: 24px; border-top: 1px solid var(--rule-strong); }
  .needs p { color: var(--ink-2); }
  @media (max-width: 900px) {
    .split, .needs, .archives { grid-template-columns: 1fr; }
  }
</style>
