---
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import { site, href } from '../config'

const removed = [
  'DATABASE_URL=postgres://app:h7Kq2x@db.internal/app',
  'STRIPE_SECRET_KEY=sk_live_51HxQe…',
  'OPENAI_API_KEY=sk-proj-Qz8v…',
  'JWT_SECRET=9f2c41e0b7d3…',
]

const journey = [
  { title: 'Link your project', body: 'Run gitvault init to pick or create a project and default environment. Writes only a tiny gitvault.json.', artifact: '$ gitvault init' },
  { title: 'Configure variables', body: 'Run gitvault config to open the interactive menu, create environments, or migrate and delete legacy .env files.', artifact: '$ gitvault config' },
  { title: 'Encrypted in your repo', body: 'Each environment is sealed with AES-256-GCM + Argon2id and synced via git and gh to your private vault repo.', artifact: 'projects/shop-api/envs/prod.enc' },
  { title: 'Loaded straight to RAM', body: 'Run gitvault load to export variables into your active shell or child process. Never written back to disk.', artifact: '$ gitvault load -- npm run dev' },
]

const loaders = [
  { icon: 'terminal', name: 'Active shell session', docs: '#load', link: 'Shell integration docs', body: 'Add one line to ~/.bashrc, ~/.zshrc, or fish so gitvault load injects variables into your live shell in memory.',
    code: `<span class="p">$</span> eval "$(gitvault shell-init)"
<span class="p">$</span> gitvault load                  <span class="c"># reads gitvault.json</span>
<span class="p">$</span> gitvault unload                <span class="c"># wipes variables from shell</span>` },
  { icon: 'code', name: 'Any language or tool', docs: '#load', link: 'Process injection docs', body: 'Inject secrets straight into a child process without writing a .env file or installing an SDK.',
    code: `<span class="p">$</span> gitvault load -- npm run dev
<span class="p">$</span> gitvault load -- cargo run
<span class="p">$</span> gitvault load -- python app.py` },
  { icon: 'branch', name: 'Explicit CLI flags', docs: '#config', link: 'CLI reference', body: 'Skip gitvault.json completely and target any project or environment from anywhere on your machine.',
    code: `<span class="p">$</span> gitvault load -p shop-api -e production -- ./deploy.sh
<span class="p">$</span> eval "$(gitvault load -p shop-api -e production --export)"
<span class="p">$</span> gitvault load -p shop-api -e production --json` },
  { icon: 'key', name: 'Servers and CI', docs: '#servers', link: 'Servers and CI docs', body: 'No interactive prompts in CI. Pass GITVAULT_PASSWORD or pipe it on stdin alongside gh authentication.',
    code: `<span class="p">$</span> GITVAULT_PASSWORD=<span class="c">••••••••</span> gitvault --non-interactive \\
    load -p shop-api -e production -- ./start.sh` },
]

const features = [
  { icon: 'terminal', title: 'Powered by git & gh', body: 'Zero internal OAuth flows, zero stored GitHub tokens. Uses your existing git and gh CLI session.' },
  { icon: 'users', title: 'Share via GitHub contributors', body: 'Need another developer on the project? Add them as a contributor to your vault repo instead of pasting .env in chat.' },
  { icon: 'history', title: 'Never lose or forget .env', body: 'Switch laptops or reinstall your OS anytime — clone the repo, unlock once, and every variable is back.' },
  { icon: 'list', title: 'Interactive config wizard', body: 'Run gitvault config to manage variables, switch or create environments, and copy secrets across envs.' },
  { icon: 'lock', title: 'Per-environment AEAD', body: 'Each environment is encrypted with AES-256-GCM bound to project and environment associated data.' },
  { icon: 'sync', title: 'Two-way git sync', body: 'Auto-commits and syncs via git pull --rebase and push, with offline-safe local fallback.' },
]

const claims = [
  { title: 'Never forget or lose .env again', body: 'Your encrypted secrets live safely in your GitHub vault repo — move machines or onboard new devs in seconds.' },
  { title: 'Share projects safely in one invite', body: 'Stop sending .env files over WhatsApp or Slack. Add teammates as contributors on the vault repo and they run gitvault load.' },
  { title: 'Zero .env files, zero extra accounts', body: 'Secrets load directly into RAM, stay encrypted at rest with Argon2id + AES-256-GCM, and use only git and gh.' },
]

const setup = [
  'Make sure git and gh are installed and signed in (gh auth login).',
  'Run gitvault init inside your project folder to create gitvault.json.',
  'Run gitvault config (or import and delete your old .env), then gitvault load.',
]
---
<Base title={site.name}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Zero-.env CLI · Powered by git & gh</span>
        <h1 class="t-display">Delete your <code class="env">.env</code> file.</h1>
        <p class="lead">GitVault encrypts your project variables in a private GitHub repository using <code>git</code> and <code>gh</code>, and loads them straight into memory with one command.</p>
        <div class="actions">
          <a class="btn btn-primary" href={href('/download/')}><Icon name="download" size={18} sw={2} />Install GitVault</a>
          <a class="btn" href={href('/docs/')}>Read the docs</a>
        </div>
        <p class="meta">v{site.version} · Pure Rust CLI (`gitvault` / `gv`) · Free and open source</p>
      </div>

      <figure class="diff" aria-label="A git diff: the .env file is deleted and gitvault.json is added">
        <div class="diff-bar"><span>shop-api</span><span>2 files changed</span></div>
        <div class="diff-file">
          <div class="diff-name"><span>.env</span><em class="tag del">deleted</em></div>
          <ol class="diff-lines">
            {removed.map((line, i) => <li class="del" style={`--i:${i}`}><b>-</b><span>{line}</span></li>)}
          </ol>
        </div>
        <div class="diff-file">
          <div class="diff-name"><span>gitvault.json</span><em class="tag add">added</em></div>
          <ol class="diff-lines">
            <li class="add"><b>+</b><span>{'{'}</span></li>
            <li class="add"><b>+</b><span>  <span class="k">"project"</span>: <span class="s">"shop-api"</span>,</span></li>
            <li class="add"><b>+</b><span>  <span class="k">"environment"</span>: <span class="s">"development"</span></span></li>
            <li class="add"><b>+</b><span>{'}'}</span></li>
          </ol>
        </div>
        <figcaption class="diff-foot"><Icon name="lock" size={14} /><span>Secrets now live encrypted in <code>projects/shop-api/envs/*.enc</code> in your private repo.</span></figcaption>
      </figure>
    </div>
  </section>

  <section class="band" id="how">
    <div class="wrap">
      <div class="head">
        <div><span class="eyebrow">How it works</span><h2 class="t-1">Three commands. Zero `.env` files.</h2></div>
        <p class="lead">Initialize your folder once, configure variables interactively, and inject secrets straight into RAM whenever you run your app.</p>
      </div>
      <ol class="journey">
        {journey.map((s, i) => (
          <li>
            <span class="step-n">{i + 1}</span>
            <h3 class="t-3">{s.title}</h3>
            <p>{s.body}</p>
            <code class="artifact">{s.artifact}</code>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="band" id="load">
    <div class="wrap">
      <div class="head">
        <div><span class="eyebrow">Load into memory</span><h2 class="t-1">Works with every language and workflow</h2></div>
        <p class="lead">No language plugins or runtime dependencies. Use <code>gitvault.json</code> for zero-flag convenience or pass <code>-p</code> and <code>-e</code> anywhere.</p>
      </div>
      <div class="loaders">
        {loaders.map((l) => (
          <article class="loader">
            <div class="loader-info">
              <div class="loader-name">
                <span class="loader-icon"><Icon name={l.icon} size={20} /></span>
                <h3 class="t-3">{l.name}</h3>
              </div>
              <p>{l.body}</p>
              <a class="arrow-link" href={`${href('/docs/')}${l.docs}`}>{l.link} <Icon name="arrow" size={16} sw={2} /></a>
            </div>
            <pre class="code" set:html={l.code} />
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" id="cli">
    <div class="wrap">
      <div class="head">
        <div><span class="eyebrow">Interactive CLI</span><h2 class="t-1">Built for speed in the terminal</h2></div>
        <p class="lead">Use interactive numbered menus when exploring, or scriptable flags when automating. Both paths use the same encrypted store.</p>
      </div>
      <div class="term-grid">
        <pre class="code term" set:html={`<span class="p">$</span> gitvault init

<span class="k">Project:</span>
  › 1) + Create new project
    2) billing-api
Choose 1-2 [1]: 1
<span class="k">Project name</span> [shop-api]:
<span class="k">Default environment:</span>
  › 1) development  2) staging  3) production
Choose 1-4 [1]: 1
<span class="k">✓</span> Initialized 'shop-api' (development) and synced
<span class="k">✓</span> Created gitvault.json (zero .env files)`} />
        <pre class="code term" set:html={`<span class="p">$</span> gitvault config

<span class="k">GitVault Config — Project: shop-api</span>
  › 1) Config variables
    2) Manage environments
    3) Import & migrate .env file
Choose 1-6 [1]: 1

<span class="k">Select or create environment:</span>
  › 1) development (3 variable(s))
    2) staging (0 variable(s))
    3) production (5 variable(s))
    4) + Create new environment`} />
      </div>
      <ul class="features">
        {features.map((f) => (
          <li><Icon name={f.icon} size={20} /><div><h3>{f.title}</h3><p>{f.body}</p></div></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band" id="security">
    <div class="wrap">
      <div class="head">
        <div><span class="eyebrow">Security</span><h2 class="t-1">Your keys, your repository</h2></div>
        <p><a class="arrow-link" href={href('/security/')}>How the encryption works <Icon name="arrow" size={16} sw={2} /></a></p>
      </div>
      <div class="claims">
        {claims.map((c) => <div><h3 class="t-3">{c.title}</h3><p>{c.body}</p></div>)}
      </div>
    </div>
  </section>

  <section class="setup">
    <div class="wrap setup-grid">
      <div>
        <h2 class="t-1">Set up in 30 seconds</h2>
        <ol class="setup-steps">{setup.map((s) => <li>{s}</li>)}</ol>
        <div class="actions">
          <a class="btn btn-primary" href={href('/download/')}><Icon name="download" size={18} sw={2} />Install GitVault</a>
          <a class="btn" href={href('/docs/')}>Get started guide</a>
        </div>
      </div>
      <pre class="code" set:html={`<span class="p">$</span> gh auth login                          <span class="c"># once</span>
<span class="p">$</span> gitvault init -p shop-api -e development
<span class="p">$</span> gitvault config import .env --delete-source
<span class="p">$</span> gitvault load -- npm run dev           <span class="c"># zero .env</span>`} />
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero { position: relative; overflow: hidden; padding-block: clamp(48px, 8vw, 96px) clamp(64px, 9vw, 112px); }
  .hero::before { content: ''; position: absolute; right: -10%; top: 0; width: 70%; height: 80%; background: radial-gradient(closest-side, var(--glow), transparent); filter: blur(60px); pointer-events: none; }
  .hero-grid { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: clamp(40px, 6vw, 80px); align-items: center; }
  .hero-copy { display: flex; flex-direction: column; gap: 24px; }
  .hero-copy .eyebrow { margin-bottom: 4px; }
  .hero-copy .lead { max-width: 520px; }
  .hero-copy .actions { margin-top: 8px; }
  .env { font: inherit; font-family: var(--mono); font-weight: 600; font-size: 0.86em; letter-spacing: -0.06em; color: var(--ink-2); background: none; border: 0; padding: 0; text-decoration: line-through; text-decoration-thickness: 0.07em; text-decoration-color: var(--del); }

  /* Diff */
  .diff { background: var(--code); color: var(--code-fg); border-radius: 16px; box-shadow: var(--shadow); overflow: hidden; font: 0.8125rem/1.7 var(--mono); border: 1px solid var(--code-rule); }
  .diff-bar { display: flex; justify-content: space-between; gap: 16px; padding: 12px 18px; background: var(--code-bar); border-bottom: 1px solid var(--code-rule); color: var(--code-dim); font-size: 0.75rem; }
  .diff-file + .diff-file { border-top: 1px solid var(--code-rule); }
  .diff-name { display: flex; align-items: center; gap: 10px; padding: 12px 18px 6px; font-weight: 600; color: var(--code-fg); }
  .tag { font-style: normal; font-weight: 500; font-size: 0.6875rem; padding: 1px 7px; border-radius: 99px; }
  .tag.del { color: var(--code-del); background: var(--code-del-bg); }
  .tag.add { color: var(--code-add); background: var(--code-add-bg); }
  .diff-lines { padding-bottom: 12px; }
  .diff-lines li { display: grid; grid-template-columns: 34px minmax(0, 1fr); min-height: 1.7em; padding-right: 18px; }
  .diff-lines b { font-weight: 400; text-align: center; color: var(--code-dim); user-select: none; }
  .diff-lines li > span { justify-self: start; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: pre; }
  .diff-lines .del { background: var(--code-del-bg); }
  .diff-lines .del b, .diff-lines .del > span { color: var(--code-del); }
  .diff-lines .add { background: var(--code-add-bg); }
  .diff-lines .add b { color: var(--code-add); }
  .diff .k { color: var(--code-key); }
  .diff .s { color: var(--code-str); }
  .diff-foot { display: flex; align-items: flex-start; gap: 10px; padding: 12px 18px; border-top: 1px solid var(--code-rule); color: var(--code-dim); font-size: 0.75rem; }
  .diff-foot svg { flex: none; margin-top: 2px; }
  .diff-foot code { background: none; border: 0; padding: 0; color: var(--code-fg); font-size: 1em; }

  @keyframes strike { from { background-size: 0% 1px; } to { background-size: 100% 1px; } }
  @keyframes appear { from { opacity: 0; transform: translateX(-8px); } to { opacity: 1; transform: none; } }
  .diff-lines .del > span { background: linear-gradient(currentColor, currentColor) no-repeat 0 55% / 100% 1px; animation: strike 0.45s cubic-bezier(.4, 0, .2, 1) both; animation-delay: calc(0.35s + var(--i) * 0.14s); }
  .diff-lines .add { animation: appear 0.5s cubic-bezier(.2, .8, .2, 1) 1.15s both; }

  /* How it works */
  .journey { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 32px; counter-reset: step; }
  .journey li { position: relative; display: flex; flex-direction: column; gap: 12px; padding-top: 28px; border-top: 1px solid var(--rule-strong); }
  .step-n { position: absolute; top: -14px; left: 0; display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: var(--paper); border: 1px solid var(--rule-strong); font: 600 0.75rem/1 var(--mono); color: var(--ink-2); }
  .journey p { color: var(--ink-2); font-size: 0.9375rem; }
  .artifact { margin-top: auto; align-self: flex-start; font-size: 0.78125rem !important; color: var(--ink); max-width: 100%; }

  /* Loaders */
  .loaders { border-top: 1px solid var(--rule); }
  .loader { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 24px 56px; padding-block: 36px; border-bottom: 1px solid var(--rule); align-items: center; }
  .loader-info { display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }
  .loader-name { display: flex; align-items: center; gap: 12px; }
  .loader-icon { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 9px; background: var(--surface); border: 1px solid var(--rule); color: var(--ink-2); }
  .loader-info p { color: var(--ink-2); max-width: 420px; }
  .loader .code { margin: 0; }

  /* Terminal showcase */
  .term-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .term { margin: 0; padding: 24px; box-shadow: var(--shadow); }
  .features { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 36px 40px; margin-top: 56px; }
  .features li { display: flex; gap: 14px; }
  .features svg { flex: none; color: var(--ink-2); margin-top: 2px; }
  .features h3 { font-size: 1rem; font-weight: 600; margin-bottom: 4px; }
  .features p { color: var(--ink-2); font-size: 0.9375rem; }

  /* Security */
  .claims { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px; }
  .claims > div { border-left: 2px solid var(--rule-strong); padding-left: 20px; display: flex; flex-direction: column; gap: 10px; }
  .claims p { color: var(--ink-2); }

  /* Closing setup band */
  .setup { position: relative; overflow: hidden; background: var(--surface); border-top: 1px solid var(--rule); padding-block: clamp(72px, 10vw, 112px); }
  .setup::before { content: ''; position: absolute; left: 50%; top: -160px; width: min(900px, 120vw); height: 320px; transform: translateX(-50%); background: radial-gradient(closest-side, var(--glow), transparent); filter: blur(40px); pointer-events: none; }
  .setup > * { position: relative; }
  .setup-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 56px; align-items: center; }
  .setup-steps { counter-reset: s; display: flex; flex-direction: column; gap: 14px; margin: 32px 0 36px; }
  .setup-steps li { counter-increment: s; display: grid; grid-template-columns: 32px 1fr; color: var(--ink-2); }
  .setup-steps li::before { content: counter(s); font: 600 0.8125rem/1.9 var(--mono); color: var(--ink-3); }
  .setup .code { background: var(--paper); border: 1px solid var(--code-rule); font-size: 0.84375rem; padding: 24px; }

  @media (max-width: 1024px) {
    .hero-grid, .setup-grid, .term-grid { grid-template-columns: 1fr; }
    .journey { grid-template-columns: 1fr 1fr; row-gap: 48px; }
    .features { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 760px) {
    .loader { grid-template-columns: 1fr; }
    .claims, .features, .journey { grid-template-columns: 1fr; }
    .diff { font-size: 0.75rem; }
  }
</style>
