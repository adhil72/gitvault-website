---
import Base from '../layouts/Base.astro'
import { site } from '../config'
const downloadUrl = (name: string) => `${site.releasesUrl}/${name}`

const platforms = [
  { name: 'Windows', req: 'Windows 10 or later', primary: ['Download installer (.exe)', 'GitVault-setup.exe'], note: 'Requires git. Install Git for Windows if you do not have it yet.' },
  { name: 'Ubuntu and Debian', req: 'Ubuntu 22.04 or later', primary: ['Download package (.deb)', 'GitVault.deb'], note: 'The .deb installs git and the GitHub CLI for you.' },
]
const needs = [
  ['A GitHub account', 'Your vault is stored in a private repository in your account. Sign in with the GitHub CLI, a personal access token or device flow.'],
  ['git on your PATH', 'Gitvault uses git for history and sync, so every change is a commit you can inspect.'],
  ['A master password', 'It never leaves your device. You also get a recovery key once, so keep it somewhere safe.'],
]
---
<Base title="Download" current="">
  <section class="page-head wrap">
    <h1 class="h1">Download Gitvault</h1>
    <p class="lead">Version {site.version} · Free and open source. The desktop app includes the gitvault command-line tool.</p>
  </section>
  <section class="wrap">
    <div class="grid c2">
      {platforms.map((p) => (
        <div class="card platform">
          <h2>{p.name}</h2>
          <span class="mono muted small">{p.req}</span>
          <a class="btn btn-primary btn-lg btn-block" href={downloadUrl(p.primary[1])}>{p.primary[0]}</a>
          <div class="alts">
            <a class="alt" href={downloadUrl('SHA256SUMS')}>Checksums<span>SHA256SUMS</span></a></div>
          <p class="note">{p.note}</p>
        </div>
      ))}
    </div>
  </section>
  <section class="section wrap" style="padding-bottom:0">
    <div class="sec-head" style="margin-bottom:32px"><h2 class="h2 sm">What you need</h2></div>
    <div class="grid c3">{needs.map(([t, b]) => <div class="card tight"><h3 class="h3 sm">{t}</h3><p>{b}</p></div>)}</div>
  </section>
  <section class="section wrap">
    <div class="split">
      <div class="stack" style="gap:16px"><h2 class="h2 sm">Prefer to build it yourself?</h2><p class="lead">Gitvault is MIT licensed. You need Node 22+, pnpm, stable Rust and the Tauri system libraries.</p></div>
      <pre class="code" set:html={`<span class="g">$</span> git clone ${site.repoUrl}.git
<span class="g">$</span> pnpm install
<span class="g">$</span> pnpm dev
<span class="c"># or the CLI only</span>
<span class="g">$</span> cargo run -p gitvault-cli -- --help`} />
    </div>
  </section>
</Base>
