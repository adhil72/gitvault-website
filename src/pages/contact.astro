---
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import { site, href } from '../config'

const topics = ['Question', 'Bug', 'Idea', 'Security']
const channels = [
  { icon: 'github', title: 'Open an issue', body: 'For bugs you can reproduce.', url: site.issuesUrl },
  { icon: 'users', title: 'Join the discussion', body: 'Ideas, questions and show-and-tell.', url: site.discussionsUrl },
  { icon: 'shield', title: 'Report a vulnerability', body: 'Privately, through a GitHub security advisory.', url: site.securityUrl },
]
---
<Base title="Contact" current="Contact" description="Questions, bugs or ideas for GitVault? Send a message.">
  <section class="wrap contact">
    <div class="intro" id="intro">
      <span class="eyebrow">Contact</span>
      <h1 class="t-1">Get in touch</h1>
      <p class="lead">Questions, bugs or ideas. Tell us what you need and we will reply.</p>
      <ul class="channels" id="alts">
        {channels.map((c) => (
          <li><a href={c.url}><Icon name={c.icon} size={20} /><span><b>{c.title}</b><small>{c.body}</small></span><Icon name="external" size={16} /></a></li>
        ))}
      </ul>
    </div>

    <form id="contact-form" class="card form" novalidate data-endpoint={site.contactEndpoint ?? ''} data-issues={site.issuesUrl} data-security={site.securityUrl}>
      <div class="field">
        <span class="lbl" id="topic-lbl">What is this about?</span>
        <div class="segmented" role="radiogroup" aria-labelledby="topic-lbl">
          {topics.map((t, i) => (<><input type="radio" name="topic" id={`t-${t}`} value={t} checked={i === 0} /><label for={`t-${t}`}>{t}</label></>))}
        </div>
        <p class="hint" id="security-hint" hidden>Please report vulnerabilities privately. <a class="prose-link" href={site.securityUrl}>Open a security advisory</a> instead of using this form.</p>
      </div>
      <div class="row2">
        <div class="field"><label for="name">Name</label><input class="input" id="name" name="name" autocomplete="name" placeholder="Your name" required /></div>
        <div class="field"><label for="email">Email</label><input class="input" id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required /><p class="hint" id="email-hint"></p></div>
      </div>
      <div class="field"><label for="message">Message</label><textarea class="input" id="message" name="message" placeholder="How can we help?" required></textarea><p class="hint" id="message-hint"></p></div>
      <!-- spam trap: keep hidden -->
      <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
      <button class="btn btn-primary btn-block send" type="submit" id="send">Send message <Icon name="arrow" size={18} sw={2} /></button>
      <p class="privacy"><Icon name="lock" size={14} />Never include passwords or keys. We use your email only to reply.</p>
    </form>

    <div class="sent" id="sent" role="status">
      <span class="sent-icon"><Icon name="check" size={32} sw={2} /></span>
      <h2 class="t-1">Message sent</h2>
      <p class="lead" id="sent-text">Thanks. We will get back to you soon.</p>
      <div class="actions"><a class="btn" href={href('/')}>Back to home</a><a class="btn" href={href('/docs/')}>Read the docs</a></div>
    </div>
  </section>
</Base>

<style>
  .contact { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(40px, 7vw, 96px); padding-block: clamp(56px, 9vw, 104px) clamp(72px, 10vw, 120px); align-items: start; }
  .intro { display: flex; flex-direction: column; gap: 20px; }
  .channels { margin-top: 20px; border-top: 1px solid var(--rule); }
  .channels a { display: flex; align-items: center; gap: 16px; padding: 18px 4px; border-bottom: 1px solid var(--rule); color: var(--ink-2); transition: color 0.15s; }
  .channels a:hover { color: var(--accent); }
  .channels span { flex: 1; display: flex; flex-direction: column; }
  .channels b { color: var(--ink); font-weight: 600; }
  .channels small { font-size: 0.875rem; color: var(--ink-2); }

  .form { display: flex; flex-direction: column; gap: 22px; padding: clamp(24px, 4vw, 36px); box-shadow: var(--shadow); }
  .field { display: flex; flex-direction: column; gap: 8px; }
  .field > label, .lbl { font-size: 0.875rem; font-weight: 600; }
  .input { width: 100%; background: var(--paper); border: 1px solid var(--rule-strong); border-radius: 10px; padding: 12px 14px; color: var(--ink); font: 1rem var(--sans); transition: border-color 0.15s, box-shadow 0.15s; }
  .input::placeholder { color: var(--ink-3); }
  .input:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 22%, transparent); }
  .input[aria-invalid='true'] { border-color: var(--del); }
  textarea.input { min-height: 160px; resize: vertical; }
  .hint { font-size: 0.8125rem; color: var(--ink-3); }
  .hint:empty { display: none; }
  .hint.err { color: var(--del); }
  .hint.ok { color: var(--add); }
  .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .segmented { display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; padding: 4px; background: var(--sunken); border: 1px solid var(--rule); border-radius: 10px; }
  .segmented input { position: absolute; opacity: 0; pointer-events: none; }
  .segmented label { text-align: center; padding: 8px 0; border-radius: 7px; font-size: 0.875rem; font-weight: 500; color: var(--ink-2); cursor: pointer; transition: background 0.15s, color 0.15s; }
  .segmented input:checked + label { background: var(--surface); color: var(--ink); font-weight: 600; box-shadow: 0 1px 3px rgb(0 0 0 / 0.4), inset 0 0 0 1px var(--rule-strong); }
  .segmented input:focus-visible + label { outline: 2px solid var(--accent); }
  .send { height: 50px; font-size: 1rem; }
  .privacy { display: flex; gap: 8px; align-items: center; justify-content: center; font-size: 0.8125rem; color: var(--ink-3); }

  .sent { display: none; grid-column: 1 / -1; flex-direction: column; align-items: flex-start; gap: 20px; max-width: 560px; }
  .sent[data-show] { display: flex; }
  .sent-icon { display: grid; place-items: center; width: 56px; height: 56px; border-radius: 50%; background: var(--accent-soft); color: var(--accent); }

  @media (max-width: 900px) {
    .contact { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .row2 { grid-template-columns: 1fr; }
    .segmented { grid-template-columns: 1fr 1fr; }
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement
  const $ = (id: string) => document.getElementById(id) as HTMLElement
  const email = form.elements.namedItem('email') as HTMLInputElement
  const message = form.elements.namedItem('message') as HTMLTextAreaElement
  const emailOk = (v: string) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)

  function mark(input: HTMLElement, hint: HTMLElement, text: string, kind: '' | 'err' | 'ok') {
    input.setAttribute('aria-invalid', String(kind === 'err'))
    hint.textContent = text
    hint.className = `hint ${kind}`
  }
  // Validate inline as the person types, not only on submit.
  const checkEmail = () => !email.value ? mark(email, $('email-hint'), '', '') : emailOk(email.value) ? mark(email, $('email-hint'), 'Looks good', 'ok') : mark(email, $('email-hint'), 'Enter a valid email address', 'err')
  email.addEventListener('input', checkEmail)
  email.addEventListener('blur', checkEmail)
  message.addEventListener('input', () => mark(message, $('message-hint'), '', ''))

  form.addEventListener('change', () => {
    const topic = (new FormData(form).get('topic') as string) ?? ''
    $('security-hint').hidden = topic !== 'Security'
  })

  function showSent(name: string, mail: string) {
    form.hidden = true
    $('alts').hidden = true
    $('intro').hidden = true
    $('sent-text').textContent = mail ? `Thanks${name ? ', ' + name : ''}. We will reply to ${mail}.` : 'Thanks. We will get back to you soon.'
    $('sent').dataset.show = ''
    window.scrollTo({ top: 0 })
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault()
    const data = new FormData(form)
    const mail = String(data.get('email') ?? '').trim()
    const body = String(data.get('message') ?? '').trim()
    if (!String(data.get('name') ?? '').trim()) { $('name').focus(); return }
    if (!emailOk(mail)) { mark(email, $('email-hint'), 'Enter a valid email address', 'err'); email.focus(); return }
    if (!body) { mark(message, $('message-hint'), 'Tell us a little about what you need', 'err'); message.focus(); return }
    const topic = String(data.get('topic'))
    const name = String(data.get('name') ?? '').trim()
    // Vulnerabilities must never become public issues, so they are sent to the private advisory form.
    if (topic === 'Security') { window.open(form.dataset.security as string, '_blank', 'noopener'); return }
    const endpoint = form.dataset.endpoint
    if (endpoint) {
      const btn = $('send') as HTMLButtonElement
      btn.disabled = true
      try {
        const res = await fetch(endpoint, { method: 'POST', headers: { Accept: 'application/json' }, body: data })
        if (!res.ok) throw new Error(String(res.status))
        showSent(name, mail)
      } catch {
        btn.disabled = false
        mark(message, $('message-hint'), 'Could not send right now. Please try again, or open a GitHub issue below.', 'err')
      }
      return
    }
    // No form service configured: hand off to a prefilled public issue. The email is not included.
    const url = new URL(form.dataset.issues as string)
    url.searchParams.set('title', `[${topic}] `)
    url.searchParams.set('body', body)
    window.open(url.toString(), '_blank', 'noopener')
    showSent(name, '')
  })
</script>
